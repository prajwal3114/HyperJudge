# Node.js Server
NODE_ENV=development
PORT=3000

# PostgreSQL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://hyperjudge:password@localhost:5432/hyperjudge_db?schema=public"

# Redis
REDIS_URL="redis://:password@localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="password"

# MongoDB (Optional)
# MONGODB_URI="mongodb://root:rootpassword@localhost:27017/hyperjudge?authSource=admin"
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/hyperjudge"

# Kafka
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="hyperjudge-api"
KAFKA_GROUP_ID="hyperjudge-api-group"

# Security
JWT_SECRET="super-secret-jwt-key-replace-in-production"

# Logging
LOG_LEVEL="debug"
